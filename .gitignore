# Credentials and tokens — nothing auth-shaped ever gets committed.
data/
*token*.json
garmin_tokens.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Runtime state — the cross-process lock and the request budget live next to
# the token file (lock.py, ratelimit.py). A test that passes a bare relative
# token path lands them here instead, which is how they first got committed.
.garmin.lock
.garmin.ratelimit.json
.garmin.ratelimit.lock

# Test recordings — cassettes are scrubbed, but never commit an unreviewed one.
tests/cassettes/*.unscrubbed.yaml

# OS / editor
.DS_Store
